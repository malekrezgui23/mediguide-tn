# R1 (cours, partie « Inférence ») : si x est de type B et B sous-classe de C, alors x est de type C.
# Exemple : medd:medicament-x a med:Generique + med:Generique rdfs:subClassOf med:MedicamentCopie
#           => medd:medicament-x a med:MedicamentCopie
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT { ?x a ?C }
WHERE {
    ?x a ?B .
    ?B rdfs:subClassOf ?C .
}
